# Backend
ENV=dev

# Database (use Neon/Supabase connection string in prod)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tundler

# JWT
JWT_SECRET=change_me_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
